{
  "name": "@ummix/ai-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --configLoader runner --port 3007",
    "build:contracts": "npm run build --prefix contracts",
    "build": "npm run build:contracts && tsc -b && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --port 3007",
    "test": "vitest run --configLoader runner"
  },
  "dependencies": {
    "@ummix/ai-contracts": "file:./contracts",
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.553.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.2.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
